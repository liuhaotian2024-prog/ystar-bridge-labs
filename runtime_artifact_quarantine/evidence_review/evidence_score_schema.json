    "candidate_id",
    "review_id",
    "source_path",
    "artifact_class",
    "disposition",
    "review_status",
    "ingestion_status",
    "structural_score",
    "source_quality_level",
    "reuse_readiness",
    "confidence_level",
    "contradiction_status",
    "semantic_truth_status",
    "evidence_basis",
    "missing_evidence",
    "allowed_next_step",
    "forbidden_next_steps",
    "brain_writeback_allowed",
    "memory_ingestion_allowed",
    "cieu_write_allowed"
