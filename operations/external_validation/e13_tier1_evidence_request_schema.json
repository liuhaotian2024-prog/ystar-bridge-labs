{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E13 Tier-1 Public Read-Only Evidence Request",
  "type": "object",
  "required": [
    "request_id",
    "mission_id",
    "entry_repository_delivery_rt1",
    "top_offer",
    "default_path",
    "opportunity_paths",
    "allowed_source_classes",
    "source_urls",
    "budget",
    "forbidden_actions",
    "counterfactual_questions",
    "run_public_collection_if_sources_available"
  ],
  "properties": {
    "request_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "entry_repository_delivery_rt1": { "const": 0 },
    "top_offer": { "type": "string" },
    "default_path": { "type": "string" },
    "opportunity_paths": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "allowed_source_classes": { "type": "array", "items": { "type": "string" } },
    "source_urls": { "type": "array", "items": { "type": "object" } },
    "budget": { "type": "object" },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "counterfactual_questions": { "type": "array", "items": { "type": "string" } },
    "run_public_collection_if_sources_available": { "type": "boolean" }
  },
  "additionalProperties": true
}
