<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ystar.cieu_to_brain_streamer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.11</string>
        <string>-u</string>
        <string>-c</string>
        <string>from ystar.governance.cieu_brain_streamer import stream_new_events_to_brain; stream_new_events_to_brain(poll_interval_sec=30.0, max_iterations=0)</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/haotianliu/.openclaw/workspace/Y-star-gov:/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs:/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs/scripts</string>
        <key>YSTAR_BRIDGE_LABS_ROOT</key>
        <string>/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs</string>
        <key>YSTAR_GOV_ROOT</key>
        <string>/Users/haotianliu/.openclaw/workspace/Y-star-gov</string>
        <key>AIDEN_BRAIN_DB</key>
        <string>/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs/aiden_brain.db</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs/scripts/.logs/cieu_to_brain_streamer.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/haotianliu/.openclaw/workspace/ystar-bridge-labs/scripts/.logs/cieu_to_brain_streamer.err.log</string>

    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
