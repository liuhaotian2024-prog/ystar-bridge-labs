{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ystar.agent_brain.aiden_ceo.pre_u_counterfactual.packet.v0",
  "title": "Aiden-CEO Pre-U Counterfactual Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "packet_id",
    "agent_id",
    "agent_capsule_ref",
    "task_id",
    "created_at",
    "y_star",
    "m_functor",
    "x_t_summary",
    "candidate_actions",
    "selected_action",
    "residual_minimization_rationale",
    "governance_expectations",
    "cieu_link_policy",
    "open_uncertainties",
    "packet_status"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "ystar.agent_brain.aiden_ceo.pre_u_counterfactual.packet"
    },
    "schema_version": {
      "type": "string",
      "const": "v0"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "Aiden-CEO"
      ]
    },
    "agent_capsule_ref": {
      "type": "string",
      "const": "agent_brains/Aiden-CEO"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 timestamp generated by future runtime."
    },
    "y_star": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "m_functor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "field_refs",
        "grounding_notes"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "field_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grounding_notes": {
          "type": "string"
        }
      }
    },
    "x_t_summary": {
      "type": "string",
      "minLength": 1
    },
    "candidate_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "u_summary",
          "predicted_y_t1",
          "predicted_r_t1",
          "expected_benefits",
          "risks",
          "assumptions",
          "evidence_refs",
          "field_alignment_notes",
          "czl_closure_notes",
          "confidence"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "u_summary": {
            "type": "string",
            "minLength": 1
          },
          "predicted_y_t1": {
            "type": "string",
            "minLength": 1
          },
          "predicted_r_t1": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "estimated_distance_to_zero",
              "scale"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "estimated_distance_to_zero": {
                "type": "number",
                "minimum": 0
              },
              "scale": {
                "type": "string",
                "description": "Future runtime must define the residual scale before using numeric comparisons."
              }
            }
          },
          "expected_benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field_alignment_notes": {
            "type": "string"
          },
          "czl_closure_notes": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "selected_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_candidate_id",
        "why_selected",
        "expected_r_t1",
        "fallback_if_wrong"
      ],
      "properties": {
        "selected_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "why_selected": {
          "type": "string",
          "minLength": 1
        },
        "expected_r_t1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "estimated_distance_to_zero",
            "scale"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "estimated_distance_to_zero": {
              "type": "number",
              "minimum": 0
            },
            "scale": {
              "type": "string"
            }
          }
        },
        "fallback_if_wrong": {
          "type": "string"
        }
      }
    },
    "residual_minimization_rationale": {
      "type": "string",
      "minLength": 1
    },
    "governance_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_y_star_validation",
        "requires_m_functor_validation",
        "requires_scope_validation",
        "requires_high_risk_review",
        "expected_hook_behavior"
      ],
      "properties": {
        "requires_y_star_validation": {
          "type": "boolean"
        },
        "requires_m_functor_validation": {
          "type": "boolean"
        },
        "requires_scope_validation": {
          "type": "boolean"
        },
        "requires_high_risk_review": {
          "type": "boolean"
        },
        "expected_hook_behavior": {
          "type": "string",
          "enum": [
            "allow_if_valid",
            "deny_if_missing_or_invalid",
            "warn_only",
            "require_human_review"
          ]
        }
      }
    },
    "cieu_link_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "should_emit_pre_action_event",
        "should_emit_post_action_event",
        "compare_predicted_vs_actual",
        "update_brain_from_delta"
      ],
      "properties": {
        "should_emit_pre_action_event": {
          "type": "boolean"
        },
        "should_emit_post_action_event": {
          "type": "boolean"
        },
        "compare_predicted_vs_actual": {
          "type": "boolean"
        },
        "update_brain_from_delta": {
          "type": "boolean"
        }
      }
    },
    "open_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packet_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_validation",
        "validation_failed",
        "approved_for_action",
        "superseded"
      ]
    }
  }
}
