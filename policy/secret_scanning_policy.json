{
  "schema_version": "v0",
  "policy_id": "secret_scanning_context_policy_v0",
  "milestone_id": "L7.0S",
  "purpose": "Distinguish real secret candidates from approved redacted examples, test fixtures, scanner-rule examples, and safe policy tokens without weakening real secret protection.",
  "policy_ref": "policy/secret_scanning_policy.json",
  "forbidden_real_secret_patterns": [
    {
      "family": "TAVILY_API_KEY",
      "provider": "tavily",
      "shape": "known_env_assignment_with_unredacted_value_or_tvly_prefix_with_long_value",
      "examples_allowed_only_when_redacted": true
    },
    {
      "family": "BRAVE_SEARCH_API_KEY",
      "provider": "brave_search",
      "shape": "known_env_assignment_with_unredacted_long_value",
      "examples_allowed_only_when_redacted": true
    },
    {
      "family": "SERPAPI_API_KEY",
      "provider": "serpapi",
      "shape": "known_env_assignment_with_unredacted_long_value",
      "examples_allowed_only_when_redacted": true
    },
    {
      "family": "generic API key",
      "provider": "generic",
      "shape": "api_key_or_secret_assignment_with_high_entropy_or_long_unredacted_value",
      "examples_allowed_only_when_redacted": true
    },
    {
      "family": "bearer token",
      "provider": "generic",
      "shape": "authorization_bearer_with_long_unredacted_value",
      "examples_allowed_only_when_redacted": true
    },
    {
      "family": "OAuth token",
      "provider": "generic",
      "shape": "oauth_access_or_refresh_token_assignment_with_long_unredacted_value",
      "examples_allowed_only_when_redacted": true
    },
    {
      "family": "private key",
      "provider": "generic",
      "shape": "private_key_block_marker_or_private_key_assignment",
      "examples_allowed_only_when_redacted": true
    }
  ],
  "allowed_redacted_placeholders": [
    "TAVILY_API_KEY_PLACEHOLDER",
    "TAVILY_API_KEY_REDACTED",
    "BRAVE_SEARCH_API_KEY_PLACEHOLDER",
    "BRAVE_SEARCH_API_KEY_REDACTED",
    "SERPAPI_API_KEY_PLACEHOLDER",
    "SERPAPI_API_KEY_REDACTED",
    "REDACTED_API_KEY_VALUE",
    "REDACTED_BEARER_TOKEN",
    "REDACTED_OAUTH_TOKEN",
    "REDACTED_PRIVATE_KEY",
    "<REDACTED>",
    "<TEST_SECRET_PLACEHOLDER>"
  ],
  "allowed_test_fixture_tokens": [
    "SECRET_EXAMPLE_TAVILY_API_KEY",
    "SECRET_EXAMPLE_BRAVE_SEARCH_API_KEY",
    "SECRET_EXAMPLE_SERPAPI_API_KEY",
    "TVLY_TEST_PREFIX_EXAMPLE",
    "BRAVE_TEST_KEY_EXAMPLE",
    "SERPAPI_TEST_KEY_EXAMPLE",
    "TEST_ONLY_API_KEY_PLACEHOLDER",
    "TEST_ONLY_BEARER_TOKEN_PLACEHOLDER"
  ],
  "allowed_documentation_tokens": [
    "TAVILY_API_KEY=<REDACTED>",
    "BRAVE_SEARCH_API_KEY=<REDACTED>",
    "SERPAPI_API_KEY=<REDACTED>",
    "Authorization: Bearer <REDACTED>",
    "api_key=REDACTED_API_KEY_VALUE",
    "PRIVATE_KEY=<REDACTED>"
  ],
  "unsafe_contexts": [
    "local_env_file",
    "repo_committed_env_file",
    "shell_history",
    "runtime_log",
    "database_file",
    "wal_file",
    "shm_file",
    "active_agent_marker",
    "secret_file",
    "credential_file",
    "generated_report_with_unredacted_secret",
    "git_staged_diff_with_real_secret"
  ],
  "safe_contexts_with_restrictions": [
    {
      "context": "tests",
      "restriction": "Only approved placeholders, TEST_ONLY markers, redacted values, or scanner-rule examples are allowed."
    },
    {
      "context": "docs",
      "restriction": "Only redacted examples or approved documentation tokens are allowed."
    },
    {
      "context": "policy",
      "restriction": "Scanner-rule examples may describe patterns but must not include real-looking concrete secret values."
    },
    {
      "context": "reports",
      "restriction": "Reports may state secret presence/absence only, never secret values."
    }
  ],
  "entropy_or_shape_checks": {
    "min_unredacted_assignment_value_length_for_block": 16,
    "min_bearer_token_length_for_block": 16,
    "tavily_prefix": "tvly-",
    "block_tavily_prefix_when_followed_by_long_value": true,
    "high_entropy_character_classes": [
      "uppercase",
      "lowercase",
      "digits",
      "dash_or_underscore"
    ],
    "approved_safety_markers": [
      "REDACTED",
      "PLACEHOLDER",
      "TEST_ONLY",
      "EXAMPLE",
      "DUMMY"
    ]
  },
  "decision_states": [
    "hard_forbidden_real_secret",
    "blocked_suspicious_secret",
    "allowed_redacted_placeholder",
    "allowed_test_fixture",
    "allowed_documentation_example",
    "allowed_scanner_rule_example",
    "review_required"
  ],
  "classification_labels": [
    "real_secret_candidate",
    "unsafe_secret_literal",
    "redacted_placeholder",
    "test_fixture_pattern",
    "documentation_example",
    "scanner_rule_example",
    "safe_policy_token"
  ],
  "no_secret_value_echo_policy": {
    "enabled": true,
    "rule": "Decision reasons must describe only the matched family and context, never the candidate secret value."
  }
}
