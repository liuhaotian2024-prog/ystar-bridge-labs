      "behavior_y_star_generation_gap",
      "projection_policy_gap"
    ],
    "pre_u_mapping_update_candidate": [
      "pre_u_mapping_gap"
    ],
    "work_alignment_update_candidate": [
      "work_alignment_gap"
    ],
    "residual_classification_update_candidate": [
      "residual_classification_gap"
    ],
    "context_only": [
      "blocked_live_gap",
      "writeback_boundary_tracking"
    ],
    "blocked": [
      "live_execution_request",
      "canonical_policy_mutation_request"
    ],
    "requires_human_or_governance_review": [
      "projection_policy",
      "behavior_y_star_generation",
      "pre_u_mapping",
      "work_proposal_alignment",
      "residual_classification",
      "evidence_collection_policy",
